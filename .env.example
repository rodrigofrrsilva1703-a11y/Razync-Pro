# Desenvolvimento local
# DATABASE_URL=sqlite:///razync_pro.db

# Produção PostgreSQL / Supabase
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO

# Supabase Auth e Storage (a chave publicável pode ser usada no cliente)
SUPABASE_URL=https://etimfgenlludorrftapb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE_DO_PROJETO

# Gere um valor aleatório com pelo menos 32 caracteres; nunca publique o valor real.
SESSION_COOKIE_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO

# Assistente Razync IA — configure os valores reais somente em Secrets.
# Gemini é o provedor preferencial quando GEMINI_API_KEY estiver configurada.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI continua disponível como alternativa quando o Gemini não estiver configurado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DAILY_REQUEST_LIMIT=20

# Integrações opcionais — nunca coloque tokens reais neste arquivo versionado.
CHECKOUT_PRO_URL=https://checkout.exemplo.com/razync-pro
OPEN_FINANCE_PROVIDER_URL=
WHATSAPP_BUSINESS_URL=
LEAKED_PASSWORD_PROTECTION_ENABLED=false
