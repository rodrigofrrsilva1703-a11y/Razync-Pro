# Copie este conteúdo para os Secrets do Streamlit Cloud.
# Nunca coloque credenciais reais neste arquivo do repositório.

# Produção segura: ativa o modo fail-closed do Razync.
APP_ENVIRONMENT = "production"

# Banco PostgreSQL / Supabase.
DATABASE_URL = "postgresql://USUARIO:SENHA@HOST:5432/BANCO"

# Supabase Auth e Storage.
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_SUBSTITUA_PELA_CHAVE_DO_PROJETO"

# Use um segredo aleatório com pelo menos 32 caracteres.
SESSION_COOKIE_SECRET = "SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO"

# Assistente Razync IA — use valores reais somente nos Secrets do Streamlit Cloud.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3.6-flash"

# OpenAI é opcional e permanece disponível como alternativa.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-5.4-mini"
OPENAI_DAILY_REQUEST_LIMIT = "20"
